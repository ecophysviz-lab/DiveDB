# =============================================================================
# EcoViz_DiveDB environment configuration
# =============================================================================
# Copy to `.env` and fill in. The repo-root .env is the source of truth; the
# submodule .env files mirror it, each keeping only the variables that submodule
# reads. Keep shared values identical across them.
#
# Naming conventions (one spelling per concept -- do not reintroduce variants):
#   NOTION_TOKEN            the integration secret     (not NOTION_API_KEY)
#   NOTION_DB_<NAME>        a Notion database ID       (not NOTION_<NAME>_DB)
#   S3_*                    Ceph/S3 object storage     (AWS_* is a separate account)
#   LOCAL_*                 host paths
#   CONTAINER_*             paths as seen inside Docker
# =============================================================================

# -----------------------------------------------------------------------------
# NOTION METADATA
# -----------------------------------------------------------------------------
# Integration secret. One name only: NOTION_TOKEN.
NOTION_TOKEN=

# Database IDs, named NOTION_DB_<NAME>. The key reflects the database's title in
# Notion -- e.g. the organism database is titled "Organism DB", so the var is
# NOTION_DB_ORGANISM (the older ANIMAL spelling is retired).
NOTION_DB_DEPLOYMENT=
NOTION_DB_RECORDING=
NOTION_DB_LOGGER=
NOTION_DB_ORGANISM=
NOTION_DB_DATASET=
NOTION_DB_SIGNAL=
NOTION_DB_STANDARDIZED_CHANNEL=
NOTION_DB_SPECIES=
NOTION_DB_ASSET=

# -----------------------------------------------------------------------------
# DATA + WAREHOUSE PATHS
# -----------------------------------------------------------------------------
# Host root holding <dataset_id>/<deployment_id>/outputs/<deployment_id>_output.nc
LOCAL_DATA_PATH=/Volumes/WORK-SSD/Datasets/Unpublished

# Host path to the local Iceberg warehouse
LOCAL_ICEBERG_PATH=/Volumes/WORK-SSD/DiveDB_Iceberg

# Warehouse path as seen inside the Docker container. Container-side mount points
# are fixed in docker-compose.development.yaml; only this one is read by code.
CONTAINER_ICEBERG_PATH=/app/iceberg_warehouse

# -----------------------------------------------------------------------------
# S3 / CEPH (Nautilus)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# s3:// URI of the Iceberg warehouse prefix.
# Defaults to s3://<S3_BUCKET>/iceberg-warehouse when unset.
S3_WAREHOUSE_PATH=

# Prefix within the bucket holding source netCDFs
S3_DATA_PREFIX=Datasets

# Iceberg catalog mode: auto | sql | in-memory
ICEBERG_CATALOG_TYPE=auto

# -----------------------------------------------------------------------------
# IMMICH MEDIA
# -----------------------------------------------------------------------------
IMMICH_API_KEY=
IMMICH_BASE_URL=
